{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://my-planner.local/schemas/semantic-parse.schema.json",
  "title": "My Planner Semantic Parse",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "intent",
    "arguments",
    "tool_requests",
    "missing_fields",
    "requires_confirmation"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "intent": {
      "enum": ["CREATE_EVENT", "QUERY_SCHEDULE", "UNKNOWN"]
    },
    "arguments": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value", "original_text"],
          "properties": {
            "kind": {
              "const": "relative"
            },
            "value": {
              "enum": ["today", "tomorrow", "day_after_tomorrow"]
            },
            "original_text": {
              "type": "string",
              "description": "Original Korean date expression. The application validates it against the aliases in temporal-concepts.yaml."
            }
          }
        },
        "start_time": {
          "type": "string",
          "description": "24-hour HH:MM. The application validates the format because this llama.cpp build cannot initialize the sampler for the equivalent regex grammar."
        }
      }
    },
    "tool_requests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tool", "arguments"],
        "properties": {
          "tool": {
            "const": "resolve_relative_date"
          },
          "arguments": {
            "type": "object",
            "additionalProperties": false,
            "required": ["expression"],
            "properties": {
              "expression": {
                "enum": ["today", "tomorrow", "day_after_tomorrow"]
              }
            }
          }
        }
      }
    },
    "missing_fields": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "requires_confirmation": {
      "type": "boolean"
    }
  }
}
